# Copy to .env.local and fill in a development Firebase project.
# Every NEXT_PUBLIC_ value is baked into the static export at build
# time, so a build carries whichever project it was built against.
# None of these are secrets; nothing secret belongs in this file.

# --- Firebase web configuration -------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development only. Never set this for a deployed build.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Cloudinary ------------------------------------------------------
# The preset must be unsigned, and its allowed formats, maximum file
# size and folder must be restricted in the Cloudinary console: the
# preset name ships in the browser bundle, so the limits in
# lib/cloudinary.ts bind this application, not the endpoint.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- App Check (optional) --------------------------------------------
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
