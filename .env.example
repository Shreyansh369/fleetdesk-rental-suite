# Copy to .env.local and fill in a development Firebase project.
# Every NEXT_PUBLIC_ value is baked into the static export at build
# time, so a build carries whichever project it was built against.
# None of these are secrets; nothing secret belongs in this file.

# --- Firebase web configuration -------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Local development only. Never set this for a deployed build.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Cloudinary ------------------------------------------------------
# The preset must be unsigned, and its allowed formats, maximum file
# size and folder must be restricted in the Cloudinary console: the
# preset name ships in the browser bundle, so the limits in
# lib/cloudinary.ts bind this application, not the endpoint.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- App Check (optional) --------------------------------------------
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# --- Plans and payment (docs/billing.md) ---------------------------
# Without any Firebase values above, the build is the browser-only
# demo. With them, visitors can also start a 7-day trial.
#
# Stripe Payment Links, one per plan, created in the Stripe
# Dashboard. Used when the billing function is not deployed.
NEXT_PUBLIC_STRIPE_LINK_SUBSCRIPTION=
NEXT_PUBLIC_STRIPE_LINK_BUYOUT=
# Set to true once `firebase deploy --only functions:billing` has
# run; the Billing page then creates Checkout Sessions through it
# and the webhook switches licences on by itself.
NEXT_PUBLIC_STRIPE_CHECKOUT_FUNCTION=false
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1
# Stripe customer portal login link (Dashboard > Settings >
# Billing > Customer portal). Only needed without the function.
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL=

# --- Contact and legal pages ----------------------------------------
NEXT_PUBLIC_SALES_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_JURISDICTION=
NEXT_PUBLIC_LEGAL_EMAIL=
