rules_version = '2';

/*
 * One Firebase project serves every workspace: each operator's
 * trial or licence is a document under /workspaces, and all of
 * its operational data lives beneath it. Nothing outside a
 * workspace is readable from inside another.
 *
 * Root collections:
 *   workspaces/{workspaceId}   the workspace and its licence
 *   accounts/{uid}             which workspace an account is in
 *   trialEmails/{email}        one free trial per email address
 *
 * Within a workspace the rules are the single-tenant rules they
 * always were, with two additions: membership is read from the
 * workspace's own users collection, and operational data is only
 * open while the licence is — a trial younger than TRIAL_DAYS,
 * or a paid workspace. TRIAL_DAYS is also in lib/license.ts; the
 * two must change together.
 *
 * Only the vendor marks a workspace paid, with the Admin SDK
 * (scripts/licence.ts); no browser can.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function tokenEmail() {
      return request.auth.token.email.lower();
    }

    function accountOf(uid) {
      return get(
        /databases/$(database)/documents/accounts/$(uid)
      );
    }


    /* =========================================================
       ACCOUNT INDEX
       ========================================================= */

    match /accounts/{uid} {

      allow get: if signedIn()
        && request.auth.uid == uid;

      /* Written once, when the account starts a trial or joins
         a workspace from an invite link, and never moved: a
         second workspace for the same sign-in is our decision,
         not the browser's. */
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          "workspaceId",
          "email",
          "createdAt"
        ])
        && request.resource.data.workspaceId is string
        && request.resource.data.email == tokenEmail()
        && request.resource.data.createdAt == request.time
        && existsAfter(
          /databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)
        );

      allow update, delete: if false;
    }


    /* =========================================================
       ONE TRIAL PER EMAIL
       ========================================================= */

    match /trialEmails/{email} {

      /* Read before starting a trial, to explain a refusal. */
      allow get: if signedIn()
        && email == tokenEmail();

      allow create: if signedIn()
        && email == tokenEmail()
        && request.resource.data.keys().hasOnly([
          "uid",
          "workspaceId",
          "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/accounts/$(request.auth.uid)
        ).data.workspaceId
            == request.resource.data.workspaceId;

      allow list, update, delete: if false;
    }


    /* =========================================================
       WORKSPACES
       ========================================================= */

    match /workspaces/{workspaceId} {

      function workspace() {
        return get(
          /databases/$(database)/documents/workspaces/$(workspaceId)
        ).data;
      }

      /* Paid, or a trial still inside its seven days. */
      function licenceActive() {
        return workspace().plan == "paid"
          || (
            workspace().plan == "trial"
            && request.time
                < workspace().trialStartedAt
                  + duration.value(7, "d")
          );
      }

      function profile() {
        return get(
          /databases/$(database)/documents/workspaces/$(workspaceId)/users/$(request.auth.uid)
        ).data;
      }

      function approvedAs(roles) {
        return signedIn()
          && profile().status == "approved"
          && profile().role in roles;
      }

      function isAdmin() {
        return approvedAs(["admin"]) && licenceActive();
      }

      function isOperations() {
        return approvedAs(["operations"]) && licenceActive();
      }

      function isStaff() {
        return approvedAs(["admin", "operations"])
          && licenceActive();
      }

      /* Members read their workspace whatever the state of the
         licence: an expired trial still has to show who to pay
         and how. */
      allow get: if signedIn()
        && accountOf(request.auth.uid).data.workspaceId
            == workspaceId;

      /* Starting a trial, all in one write: this workspace,
         its owner's account entry and administrator profile,
         and the claim on the owner's email that stops a second
         trial being started with it. */
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "name",
          "ownerUid",
          "adminEmail",
          "plan",
          "trialStartedAt",
          "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.adminEmail == tokenEmail()
        && request.resource.data.plan == "trial"
        && request.resource.data.trialStartedAt == request.time
        && request.resource.data.createdAt == request.time
        && !exists(
          /databases/$(database)/documents/accounts/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/accounts/$(request.auth.uid)
        ).data.workspaceId == workspaceId
        && !exists(
          /databases/$(database)/documents/trialEmails/$(tokenEmail())
        )
        && getAfter(
          /databases/$(database)/documents/trialEmails/$(tokenEmail())
        ).data.workspaceId == workspaceId;

      /* An administrator may rename the workspace, and records
         once that a Stripe checkout was completed so the vendor
         knows to confirm it. Neither touches the licence. */
      allow update: if approvedAs(["admin"])
        && request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          "name",
          "paymentSubmittedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() >= 2
        && request.resource.data.name.size() <= 80
        && (
          !request.resource.data.diff(
            resource.data
          ).affectedKeys().hasAny(["paymentSubmittedAt"])
          || (
            !("paymentSubmittedAt" in resource.data)
            && request.resource.data.paymentSubmittedAt
                == request.time
          )
        );

      allow delete: if false;

      /* =========================================================
         USERS / STAFF
         ========================================================= */

      match /users/{userId} {

        /* Everyone can read their own profile, whatever the
           state of the licence: it is how the workspace tells a
           pending account from an approved one, and an expired
           trial from a broken sign-in. */
        allow get: if signedIn()
          && request.auth.uid == userId;

        /* Administrators read and list the staff. */
        allow get, list: if isAdmin();

        /* Joining from an invite link creates the account's own
           pending profile, in the same write as the account index
           entry that names this workspace. A user cannot assign
           an approved role to itself. */
        allow create: if signedIn()
          && request.auth.uid == userId
          && getAfter(
            /databases/$(database)/documents/accounts/$(request.auth.uid)
          ).data.workspaceId == workspaceId
          && request.resource.data.status == "pending"
          && request.resource.data.role == null
          && request.resource.data.requestedRole in [
            "admin",
            "operations"
          ]
          && request.resource.data.email.lower()
              == tokenEmail();

        /* Starting a trial creates the workspace and its owner's
           administrator profile together. This is the only way a
           profile is ever created approved from a browser, and it
           only works while the workspace itself is being created
           in the same write, by its owner. */
        allow create: if signedIn()
          && request.auth.uid == userId
          && !exists(
            /databases/$(database)/documents/workspaces/$(workspaceId)
          )
          && getAfter(
            /databases/$(database)/documents/workspaces/$(workspaceId)
          ).data.ownerUid == request.auth.uid
          && request.resource.data.role == "admin"
          && request.resource.data.status == "approved"
          && request.resource.data.requestedRole == "admin"
          && request.resource.data.email.lower()
              == request.auth.token.email.lower();

        /* Pending users may update only their
           registration information. */
        allow update: if signedIn()
          && request.auth.uid == userId
          && resource.data.role
              == request.resource.data.role
          && resource.data.status
              == request.resource.data.status
          && resource.data.requestedRole
              == request.resource.data.requestedRole
          && request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            "fullName",
            "mobile",
            "age",
            "email",
            "updatedAt"
          ]);

        /* Only admins can approve, reject,
           or change staff roles. */
        allow update: if isAdmin();

        /* Only admins can remove staff profiles. */
        allow delete: if isAdmin();
      }


      /* =========================================================
         VEHICLES
         ========================================================= */

      match /vehicles/{vehicleId} {

        allow read: if isStaff();

        allow create, update: if isStaff();

        allow delete: if isAdmin();
      }


      match /vehicles/{vehicleId}/serviceRecords/{recordId} {

        allow read: if isStaff();

        allow create, update: if isStaff();

        allow delete: if isAdmin();
      }


      /* =========================================================
         VEHICLE UNIQUENESS CLAIMS
         ========================================================= */

      match /vehicleRegistry/{key} {

        /* One document per registration number and VIN. Two
           concurrent vehicle writes contend on the same claim,
           so exactly one of them can take it. Staff may release
           a claim when a vehicle is renamed. */
        allow read, create, update, delete: if isStaff();
      }


      /* =========================================================
         CUSTOMERS
         ========================================================= */

      match /customers/{customerId} {

        allow read: if isStaff();

        allow create, update: if isStaff();

        allow delete: if isAdmin();
      }


      /* =========================================================
         RESERVATIONS
         ========================================================= */

      match /reservations/{reservationId} {

        allow read: if isStaff();

        allow create: if isStaff();

        /* A booking is only cancelled with a reason: the
           cancelled list on Bookings says why each one went. */
        allow update: if isStaff()
          && (
            request.resource.data.get("status", null)
                != "cancelled"
            || resource.data.get("status", null)
                == "cancelled"
            || (
              request.resource.data.get(
                "cancellationReason", null
              ) is string
              && request.resource.data.cancellationReason
                  .trim().size() > 0
            )
          );

        allow delete: if isAdmin();
      }


      /* =========================================================
         CONTRACT REVIEW AND FINALISATION
         ========================================================= */

      match /reservationContracts/{reservationId} {

        allow read: if isStaff();

        /* A contract enters the workflow already waiting for
           review, so there is no separate draft record to keep
           in step with the booking it describes. */
        allow create: if isStaff()
          && request.resource.data.status == "in_review"
          && request.resource.data.version == 1;

        /* Resubmission after a rejection. The version advances
           so an approved snapshot is always attributable to
           the round of review that produced it. */
        allow update: if isStaff()
          && resource.data.status == "rejected"
          && request.resource.data.status == "in_review"
          && request.resource.data.version
              == resource.data.version + 1;

        /* Only an administrator finalises a contract, and only
           one that is actually waiting for review. An approved
           contract is terminal: no later update matches. */
        allow update: if isAdmin()
          && resource.data.status == "in_review"
          && request.resource.data.status in [
            "approved",
            "rejected"
          ]
          && request.resource.data.version
              == resource.data.version;

        allow delete: if false;
      }


      match /reservationContracts/{reservationId}/versions/{version} {

        /* The frozen agreement: written once by the
           administrator who approved it, and immutable from
           then on, so what was sent can always be reproduced. */
        allow read: if isStaff();

        allow create: if isAdmin();

        allow update, delete: if false;
      }


      match /reservationContracts/{reservationId}/deliveries/{deliveryId} {

        /* Append-only delivery receipts recording when a
           contract was emailed, to whom, and which version. */
        allow read, create: if isStaff();

        allow update, delete: if false;
      }


      /* =========================================================
         RENTALS
         ========================================================= */

      match /rentals/{rentalId} {

        allow read: if isStaff();

        allow create, update: if isStaff();

        allow delete: if isAdmin();
      }


      match /rentals/{rentalId}/inspections/{inspectionId} {

        allow read: if isStaff();

        allow create, update: if isStaff();

        allow delete: if isAdmin();
      }


      match /rentals/{rentalId}/extensions/{extensionId} {

        /* One record per extension, keyed by its idempotency
           key. Append-only: an extension that has been priced
           and charged cannot be rewritten from a browser. */
        allow read, create: if isStaff();

        allow update, delete: if false;
      }


      /* =========================================================
         RENTAL FINANCIALS
         ========================================================= */

      match /rentalFinancials/{rentalId} {

        allow read: if isStaff();

        allow create, update: if isStaff();

        allow delete: if isAdmin();
      }


      /* =========================================================
         PAYMENTS
         ========================================================= */

      match /payments/{paymentId} {

        allow read: if isStaff();

        allow create: if isStaff();

        allow update, delete: if isAdmin();
      }


      /* =========================================================
         DISCOUNTS
         ========================================================= */

      match /rentalDiscounts/{discountId} {

        allow read: if isStaff();

        /* Anyone on staff may offer a discount, in their own
           name, and it waits for an administrator. Only an
           administrator's own discount may be approved as it
           is written. */
        allow create: if isStaff()
          && request.resource.data.requestedBy
              == request.auth.uid
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && (
            request.resource.data.status == "pending"
            || (
              isAdmin()
              && request.resource.data.status == "approved"
            )
          );

        /* Only an administrator decides, only once, and never
           by changing what was asked for. */
        allow update: if isAdmin()
          && resource.data.status == "pending"
          && request.resource.data.status in [
            "approved",
            "rejected"
          ]
          && request.resource.data.rentalId
              == resource.data.rentalId
          && request.resource.data.amountCents
              == resource.data.amountCents
          && request.resource.data.requestedBy
              == resource.data.requestedBy;

        allow delete: if false;
      }


      /* =========================================================
         REFUNDS
         ========================================================= */

      match /refunds/{refundId} {

        allow read: if isAdmin();

        allow create, update, delete: if isAdmin();
      }


      /* =========================================================
         FINANCIAL LEDGER
         ========================================================= */

      match /financialLedger/{entryId} {

        allow read: if isAdmin();

        allow create: if isStaff();

        allow update, delete: if isAdmin();
      }


      /* =========================================================
         VEHICLE EXPENSES
         ========================================================= */

      match /vehicleExpenses/{expenseId} {

        /* Recording an expense is operational work, so any
           approved account may add one and read back what it
           recorded itself — a query it can only run by
           filtering on its own uid. Everybody else's entries,
           and therefore the cost side of the business, stay
           with an administrator. */
        allow read: if isAdmin()
          || (
            isStaff()
            && resource.data.recordedBy
                == request.auth.uid
          );

        allow create: if isStaff()
          && request.resource.data.recordedBy
              == request.auth.uid;

        allow update, delete: if isAdmin();
      }


      /* =========================================================
         AUDIT LOGS
         ========================================================= */

      match /auditLogs/{auditId} {

        allow read: if isAdmin();

        allow create: if isStaff();

        allow update, delete: if isAdmin();
      }


      /* =========================================================
         IDEMPOTENCY
         ========================================================= */

      match /idempotencyKeys/{key} {

        /* Records are create-only so a completed payment,
           refund or expense cannot be replayed by clearing
           its key. */
        allow read, create: if isStaff();

        allow update, delete: if false;
      }
    }


    /* =========================================================
       DEFAULT DENY
       ========================================================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
