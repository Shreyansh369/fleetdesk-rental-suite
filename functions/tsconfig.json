  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "lib",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "../packages/domain/src/**/*.ts"]
}
